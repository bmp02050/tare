{
  "about": "Feelings wheel (core > secondary > specific, clockwise from 12 o'clock) and reflection prompts used after naming a feeling. Words follow the widely used feelings-wheel vocabulary; the drawing is generated by the app. Android bundles an identical copy in android/app/src/main/assets/.",
  "wheel": [
    {"text": "Fearful", "color": "#E9B44C", "children": [
      {"text": "Scared", "children": ["Helpless", "Frightened"]},
      {"text": "Anxious", "children": ["Overwhelmed", "Worried"]},
      {"text": "Insecure", "children": ["Inadequate", "Inferior"]},
      {"text": "Weak", "children": ["Worthless", "Insignificant"]},
      {"text": "Rejected", "children": ["Excluded", "Persecuted"]},
      {"text": "Threatened", "children": ["Nervous", "Exposed"]}
    ]},
    {"text": "Angry", "color": "#E2645A", "children": [
      {"text": "Let down", "children": ["Betrayed", "Resentful"]},
      {"text": "Humiliated", "children": ["Disrespected", "Ridiculed"]},
      {"text": "Bitter", "children": ["Indignant", "Violated"]},
      {"text": "Mad", "children": ["Furious", "Jealous"]},
      {"text": "Aggressive", "children": ["Provoked", "Hostile"]},
      {"text": "Frustrated", "children": ["Infuriated", "Annoyed"]},
      {"text": "Distant", "children": ["Withdrawn", "Numb"]},
      {"text": "Critical", "children": ["Skeptical", "Dismissive"]}
    ]},
    {"text": "Disgusted", "color": "#9A9AA0", "children": [
      {"text": "Disapproving", "children": ["Judgmental", "Embarrassed"]},
      {"text": "Disappointed", "children": ["Appalled", "Revolted"]},
      {"text": "Awful", "children": ["Nauseated", "Detestable"]},
      {"text": "Repelled", "children": ["Horrified", "Hesitant"]}
    ]},
    {"text": "Sad", "color": "#6F9BD6", "children": [
      {"text": "Hurt", "children": ["Embarrassed", "Disappointed"]},
      {"text": "Depressed", "children": ["Inferior", "Empty"]},
      {"text": "Guilty", "children": ["Remorseful", "Ashamed"]},
      {"text": "Despair", "children": ["Powerless", "Grief"]},
      {"text": "Vulnerable", "children": ["Fragile", "Victimized"]},
      {"text": "Lonely", "children": ["Abandoned", "Isolated"]}
    ]},
    {"text": "Happy", "color": "#E3D64E", "children": [
      {"text": "Optimistic", "children": ["Inspired", "Hopeful"]},
      {"text": "Trusting", "children": ["Intimate", "Sensitive"]},
      {"text": "Peaceful", "children": ["Thankful", "Loving"]},
      {"text": "Powerful", "children": ["Creative", "Courageous"]},
      {"text": "Accepted", "children": ["Valued", "Respected"]},
      {"text": "Proud", "children": ["Confident", "Successful"]},
      {"text": "Interested", "children": ["Inquisitive", "Curious"]},
      {"text": "Content", "children": ["Joyful", "Free"]},
      {"text": "Playful", "children": ["Cheeky", "Silly"]}
    ]},
    {"text": "Surprised", "color": "#A889CF", "children": [
      {"text": "Excited", "children": ["Energetic", "Eager"]},
      {"text": "Amazed", "children": ["Awe", "Astonished"]},
      {"text": "Confused", "children": ["Perplexed", "Disillusioned"]},
      {"text": "Startled", "children": ["Dismayed", "Shocked"]}
    ]},
    {"text": "Bad", "color": "#5DB98A", "children": [
      {"text": "Tired", "children": ["Unfocused", "Sleepy"]},
      {"text": "Stressed", "children": ["Out of control", "Overwhelmed"]},
      {"text": "Busy", "children": ["Rushed", "Pressured"]},
      {"text": "Bored", "children": ["Apathetic", "Indifferent"]}
    ]}
  ],
  "questions": [
    {"id": "trigger", "text": "What happened right before this?", "hint": "where you were, who with, what was said or done", "always": true},
    {"id": "why", "text": "Why do you think you feel this way?", "hint": "what you're telling yourself about it"},
    {"id": "body", "text": "Where do you feel it in your body?", "hint": "chest, jaw, stomach, shoulders, hands..."},
    {"id": "roots", "text": "Is this familiar? Where does it come from?", "hint": "an older situation, a pattern, a person"},
    {"id": "urge", "text": "What do you feel like doing right now?", "hint": "the urge, not what you'll actually do", "not": ["Happy"]},
    {"id": "need", "text": "What do you need right now?", "hint": "rest, space, food, connection, to be heard..."},
    {"id": "friend", "text": "What would you say to a friend who felt this?", "not": ["Happy"]},
    {"id": "next", "text": "What's one small thing you could do next?"},
    {"id": "savor", "text": "What made this good, and how could you get more of it?", "only": ["Happy", "Surprised"]}
  ]
}
